<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Follow storage-z-capacity-100.xml so fresh and existing databases end at
         the greatest full 5x5-page capacity that fits the signed-byte storage protocol. -->
    <changeSet id="storage-capacity-125" author="soloMapling">
        <update tableName="storages">
            <column name="slots" valueNumeric="125"/>
            <where>slots &lt; 125</where>
        </update>
        <sql>ALTER TABLE storages ALTER COLUMN slots SET DEFAULT 125</sql>
    </changeSet>
</databaseChangeLog>
